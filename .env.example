# OpenRouter API Key for Resilient LLM Inference
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# PostgreSQL Database Connection
# Defaults to local Docker container on port 5432 (or 15432)
# Automatic fallback to local SQLite (data/outreach.db) is enabled if PostgreSQL is unavailable
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yc_outreach

# Redis Cache Connection
# Automatic fallback to in-memory dictionary cache is enabled if Redis is unavailable
REDIS_URL=redis://localhost:6379/0

# Optional Server & Dashboard Overrides
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8501
